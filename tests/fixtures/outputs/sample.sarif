{"version": "2.1.0", "runs": [{"tool": {"driver": {"name": "eslint", "rules": [
   {"id": "no-unused-vars", "shortDescription": {"text": "Unused variable"}, "helpUri": "https://eslint.org/no-unused-vars", "defaultConfiguration": {"level": "warning"}}]}},
 "results": [
